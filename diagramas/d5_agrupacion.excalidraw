okeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "hachure", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 388850404, "version": 1, "versionNonce": 148614792, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "index": "a0092", "text": "Cuadrado morado = centroide. El ciclo 2-3 se repite hasta que los grupos dejan de cambiar.\nk se elige con el método del codo y se revisa con el coeficiente de silueta.", "originalText": "Cuadrado morado = centroide. El ciclo 2-3 se repite hasta que los grupos dejan de cambiar.\nk se elige con el método del codo y se revisa con el coeficiente de silueta.", "fontSize": 21, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}